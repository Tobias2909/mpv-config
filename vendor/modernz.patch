+-- local patch: SponsorBlock segments from scripts/sponsorblock.lua, all in one
+-- colour, named in the seek bar tooltip and used as right click snap points
+local SB_COLOR = "#B00020"
+local SB_ALPHA = 0        -- 0 opaque, 255 invisible
+local SB_HEIGHT = 1.0     -- share of the bar height, centred
+
+local function get_sponsorblock_segment(possec)
+    for _, s in ipairs(state.sb_segments) do
+        if possec >= s.start and possec < s.stop then return s end
+    end
+end
+
+local function draw_sponsorblock_ranges(element, elem_ass)
+    if element.name ~= "seekbar" or not state.duration or state.duration <= 0 then return end
+    if #state.sb_segments == 0 then return end
+    local slider_lo = element.layout.slider
+    local elem_geo = element.layout.geometry
+    local full = elem_geo.h - 2 * slider_lo.gap
+    local inset = slider_lo.gap + full * (1 - SB_HEIGHT) / 2
+    elem_ass:draw_stop()
+    elem_ass:merge(element.style_ass)
+    ass_append_alpha(elem_ass, element.layout.alpha, SB_ALPHA)
+    elem_ass:append("{\\blur0\\bord0\\1c&H" .. osc_color_convert(SB_COLOR) .. "&}")
+    elem_ass:merge(element.static_ass)
+    for _, s in ipairs(state.sb_segments) do
+        -- a segment touching either end of the video covers the bar's rounded cap too
+        local at_start, at_end = s.start <= 0, s.stop >= state.duration
+        local ax = at_start and 0 or get_slider_ele_pos_for(element, s.start / state.duration * 100)
+        local bx = at_end and elem_geo.w or get_slider_ele_pos_for(element, s.stop / state.duration * 100)
+        bx = math.max(bx, ax + 2)   -- keep a short segment visible on a long video
+        elem_ass:round_rect_cw(ax, inset, bx, elem_geo.h - inset,
+            at_start and slider_lo.radius or 0, at_end and slider_lo.radius or 0)
+    end
+end
